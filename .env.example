# motion-toolbox environment template
# Copy to .env and fill in the paths you need. None of these are required
# for the unit tests (the test suite skips paths that depend on them).

# --- SMPL / SMPL-X body models -----------------------------------------------
# Directory containing the SMPL family body model files (smpl/SMPL_NEUTRAL.pkl,
# smplh/SMPLH_NEUTRAL.npz, smplx/SMPLX_NEUTRAL.npz, etc.). Required for any
# demo / script that converts to or from raw SMPL parameters and for the
# `requires_smpl`-marked tests.
SMPL_BODY_MODELS_PATH=

# --- MHR (Momentum Human Rig) ------------------------------------------------
# Directory containing the MHR assets (created by `scripts/setup_mhr.sh`).
# Only needed for MHR-mode visualisation / conversion.
MHR_ASSETS_DIR=

# --- Hugging Face dataset (template helpers) ---------------------------------
# Used by scripts/fetch_sample_data_template.sh and
# scripts/download_272_samples_template.py once the public dataset mirror is
# wired up. See the templates for the full set of overridable variables.
HF_USER=
DATASET_NAME=
REVISION=main
HF_PATH_IN_REPO=

# --- S3 helpers (optional) ---------------------------------------------------
# Only required by scripts/convert_humanml3d_to_272.py and
# scripts/verify_smpl_mirror.py when uploading or verifying mirror buckets.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-west-2
# MOTION_TOOLBOX_S3_BUCKET=
